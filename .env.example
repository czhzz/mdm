# 环境变量模板：复制为 .env 使用
#   1. cp .env.example .env
#   2. 按需修改 .env 中的值（.env 已被 .gitignore 忽略，勿提交真实密码）
# 通过 .vscode/launch.json 的 envFile 加载，启动 Spring Boot 时生效
# 优先级：环境变量 > application-{profile}.yml > application.yml

# ---- 数据源（对应 application-druid.yml 中的 ${MYSQL_*} 占位符）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=password

# ---- Redis（对应 application.yml 中的 ${REDIS_*} 占位符）----
# 留空 = 无密码（默认）；填入密码后 docker 与本地开发同时启用该密码
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 说明 ----
# 若需要改服务端口：需先将 application.yml 的 port 改为 ${SERVER_PORT:8080}，再在此设置 SERVER_PORT
# 其他想覆盖的配置：spring.datasource.password -> SPRING_DATASOURCE_PASSWORD
