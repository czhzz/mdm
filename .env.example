# 环境变量模板：复制为 .env 使用
#   1. cp .env.example .env
#   2. 按需修改 .env 中的值（.env 已被 .gitignore 忽略，勿提交真实密码）
# 通过 .vscode/launch.json 的 envFile 加载，启动 Spring Boot 时生效
# 优先级：环境变量 > application-{profile}.yml > application.yml
# docker compose 部署时，以下变量对 mysql/redis/backend 服务生效（缺失时用默认值兜底）

# ---- 服务端口 ----
# docker compose：仅作为宿主映射端口（容器内固定 8080）
SERVER_PORT=8080
# docker compose 宿主映射（容器内 nginx 固定 80）
FRONTEND_PORT=80

# ---- 数据源（application-druid.yml 中的 ${MYSQL_*} 占位符）----
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=mdm
MYSQL_USERNAME=root
MYSQL_PASSWORD=password

# ---- Redis（application.yml 中的 ${REDIS_*} 占位符）----
# 留空 = 无密码（默认）；填入密码后 docker 与本地开发同时启用该密码
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Druid 监控（application-druid.yml 中的 ${DRUID_*} 占位符）----
DRUID_USERNAME=ruoyi
DRUID_PASSWORD=123456
# Druid 监控总开关（false 关闭监控台与统计）
DRUID_MONITOR_ENABLED=true

# ---- JWT 令牌（application.yml 中的 ${TOKEN_SECRET} 占位符）----
# 生产环境务必改为随机长字符串！
TOKEN_SECRET=abcdefghijklmnopqrstuvwxyz

# ---- Swagger 接口文档（application.yml 中的 ${SWAGGER_ENABLED} 占位符）----
# 生产环境建议关闭（false）
SWAGGER_ENABLED=true

# ---- RabbitMQ（application.yml 中的 ${RABBITMQ_*} 占位符）----
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# ---- 说明 ----
# 其他想覆盖的配置：spring.datasource.password -> SPRING_DATASOURCE_PASSWORD
