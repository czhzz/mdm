<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mdm.integration.mapper.MdmDistributeLogMapper">

    <resultMap type="MdmDistributeLog" id="MdmDistributeLogResult">
        <id     property="recordId"    column="record_id"     />
        <result property="appId"       column="app_id"        />
        <result property="appCode"     column="app_code"      />
        <result property="objectCode"  column="object_code"   />
        <result property="dataId"      column="data_id"       />
        <result property="actionType"  column="action_type"   />
        <result property="endpointUrl" column="endpoint_url"  />
        <result property="payload"     column="payload"       />
        <result property="status"      column="status"        />
        <result property="errorMsg"    column="error_msg"     />
        <result property="sendTime"    column="send_time"     />
        <result property="successTime" column="success_time"  />
        <result property="confirmTime" column="confirm_time"  />
        <result property="retryCount"  column="retry_count"   />
        <result property="appName"     column="app_name"      />
        <result property="createBy"    column="create_by"     />
        <result property="createTime"  column="create_time"   />
        <result property="updateBy"    column="update_by"     />
        <result property="updateTime"  column="update_time"   />
        <result property="remark"      column="remark"        />
    </resultMap>

    <sql id="selectRecordVo">
        select r.record_id, r.app_id, r.app_code, r.object_code, r.data_id, r.action_type, r.endpoint_url, r.payload, r.status,
               r.error_msg, r.send_time, r.success_time, r.confirm_time, r.retry_count,
               r.create_by, r.create_time, r.update_by, r.update_time, r.remark,
               a.app_name
        from mdm_distribute_log r
        left join mdm_app a on a.app_id = r.app_id
    </sql>

    <select id="selectRecordById" parameterType="Long" resultMap="MdmDistributeLogResult">
        <include refid="selectRecordVo"/>
        where r.record_id = #{recordId}
    </select>

    <select id="selectRecordList" parameterType="MdmDistributeLog" resultMap="MdmDistributeLogResult">
        <include refid="selectRecordVo"/>
        <where>
            <if test="appId != null">and r.app_id = #{appId}</if>
            <if test="appCode != null and appCode != ''">and r.app_code = #{appCode}</if>
            <if test="objectCode != null and objectCode != ''">and r.object_code = #{objectCode}</if>
            <if test="status != null and status != ''">and r.status = #{status}</if>
            <if test="actionType != null and actionType != ''">and r.action_type = #{actionType}</if>
        </where>
        order by r.record_id desc
    </select>

    <insert id="insertRecord" parameterType="MdmDistributeLog" useGeneratedKeys="true" keyProperty="recordId">
        insert into mdm_distribute_log (
            app_id, app_code, object_code, data_id, action_type, endpoint_url, payload,
            <if test="status != null and status != ''">status,</if>
            create_by, create_time
        ) values (
            #{appId}, #{appCode}, #{objectCode}, #{dataId}, #{actionType}, #{endpointUrl}, #{payload},
            <if test="status != null and status != ''">#{status},</if>
            #{createBy}, sysdate()
        )
    </insert>

    <update id="updatePushResult" parameterType="MdmDistributeLog">
        update mdm_distribute_log
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            error_msg = #{errorMsg},
            <if test="sendTime != null and sendTime != ''">send_time = #{sendTime},</if>
            <if test="successTime != null and successTime != ''">success_time = #{successTime},</if>
            <if test="retryCount != null">retry_count = #{retryCount},</if>
            update_time = sysdate()
        </set>
        where record_id = #{recordId}
    </update>

    <update id="updateConfirm" parameterType="MdmDistributeLog">
        update mdm_distribute_log
        set confirm_time = sysdate(), status = '1', update_time = sysdate()
        where record_id = #{recordId}
    </update>

    <!-- 最近 N 条记录（监控统计用，1.1.0） -->
    <select id="selectRecentRecords" parameterType="int" resultMap="MdmDistributeLogResult">
        select * from mdm_distribute_log order by record_id desc limit #{limit}
    </select>

    <!-- 手动清理：删除截止时间前的记录 -->
    <delete id="deleteBeforeTime" parameterType="String">
        delete from mdm_distribute_log where create_time &lt;= #{beforeTime}
    </delete>

</mapper>
