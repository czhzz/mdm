<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mdm.model.mapper.MdmCategoryMapper">

    <resultMap type="MdmCategory" id="MdmCategoryResult">
        <id     property="categoryId"    column="category_id"    />
        <result property="parentId"      column="parent_id"      />
        <result property="ancestors"     column="ancestors"      />
        <result property="categoryName"  column="category_name"  />
        <result property="categoryCode"  column="category_code"  />
        <result property="orderNum"      column="order_num"      />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectCategoryVo">
        select category_id, parent_id, ancestors, category_name, category_code, order_num, status,
               create_by, create_time, update_by, update_time, remark
        from mdm_category
    </sql>

    <select id="selectCategoryById" parameterType="Long" resultMap="MdmCategoryResult">
        <include refid="selectCategoryVo"/>
        where category_id = #{categoryId}
    </select>

    <select id="selectCategoryList" parameterType="MdmCategory" resultMap="MdmCategoryResult">
        <include refid="selectCategoryVo"/>
        <where>
            <if test="parentId != null">and parent_id = #{parentId}</if>
            <if test="categoryName != null and categoryName != ''">and category_name like concat('%', #{categoryName}, '%')</if>
            <if test="categoryCode != null and categoryCode != ''">and category_code like concat('%', #{categoryCode}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by parent_id, order_num
    </select>

    <select id="checkCategoryCodeUnique" parameterType="String" resultMap="MdmCategoryResult">
        <include refid="selectCategoryVo"/>
        where category_code = #{categoryCode} limit 1
    </select>

    <insert id="insertCategory" parameterType="MdmCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into mdm_category (
            parent_id, ancestors,
            <if test="categoryName != null and categoryName != ''">category_name,</if>
            <if test="categoryCode != null and categoryCode != ''">category_code,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
            update_by, update_time
        )values(
            #{parentId}, #{ancestors},
            <if test="categoryName != null and categoryName != ''">#{categoryName},</if>
            <if test="categoryCode != null and categoryCode != ''">#{categoryCode},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
            #{updateBy}, sysdate()
        )
    </insert>

    <update id="updateCategory" parameterType="MdmCategory">
        update mdm_category
        <set>
            <if test="categoryName != null and categoryName != ''">category_name = #{categoryName},</if>
            <if test="categoryCode != null and categoryCode != ''">category_code = #{categoryCode},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId}
    </update>

    <delete id="deleteCategoryById" parameterType="Long">
        delete from mdm_category where category_id = #{categoryId}
    </delete>

    <select id="hasChildByCategoryId" parameterType="Long" resultType="int">
        select count(1) from mdm_category where parent_id = #{categoryId}
    </select>

</mapper>
