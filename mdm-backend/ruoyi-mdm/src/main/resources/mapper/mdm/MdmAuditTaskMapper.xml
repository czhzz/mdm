<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mdm.maintenance.mapper.MdmAuditTaskMapper">

    <resultMap type="MdmAuditTask" id="MdmAuditTaskResult">
        <id     property="taskId"       column="task_id"        />
        <result property="objectId"     column="object_id"      />
        <result property="dataId"       column="data_id"        />
        <result property="actionType"   column="action_type"    />
        <result property="beforeData"   column="before_data"    />
        <result property="afterData"    column="after_data"     />
        <result property="status"       column="status"         />
        <result property="rejectReason" column="reject_reason"  />
        <result property="submitBy"     column="submit_by"      />
        <result property="auditBy"      column="audit_by"       />
        <result property="auditTime"    column="audit_time"     />
        <result property="createBy"     column="create_by"      />
        <result property="createTime"   column="create_time"    />
        <result property="updateBy"     column="update_by"      />
        <result property="updateTime"   column="update_time"    />
        <result property="remark"       column="remark"         />
    </resultMap>

    <sql id="selectTaskVo">
        select task_id, object_id, data_id, action_type, before_data, after_data, status, reject_reason,
               submit_by, audit_by, audit_time, create_by, create_time, update_by, update_time, remark
        from mdm_audit_task
    </sql>

    <select id="selectTaskById" parameterType="Long" resultMap="MdmAuditTaskResult">
        <include refid="selectTaskVo"/>
        where task_id = #{taskId}
    </select>

    <select id="selectTaskList" parameterType="MdmAuditTask" resultMap="MdmAuditTaskResult">
        <include refid="selectTaskVo"/>
        <where>
            <if test="objectId != null">and object_id = #{objectId}</if>
            <if test="actionType != null and actionType != ''">and action_type = #{actionType}</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by task_id desc
    </select>

    <insert id="insertTask" parameterType="MdmAuditTask" useGeneratedKeys="true" keyProperty="taskId">
        insert into mdm_audit_task (
            object_id, data_id, action_type,
            <if test="beforeData != null">before_data,</if>
            <if test="afterData != null">after_data,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="rejectReason != null">reject_reason,</if>
            <if test="submitBy != null and submitBy != ''">submit_by,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
            update_by, update_time
        )values(
            #{objectId}, #{dataId}, #{actionType},
            <if test="beforeData != null">#{beforeData},</if>
            <if test="afterData != null">#{afterData},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="rejectReason != null">#{rejectReason},</if>
            <if test="submitBy != null and submitBy != ''">#{submitBy},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
            #{updateBy}, sysdate()
        )
    </insert>

    <update id="updateTaskResult" parameterType="MdmAuditTask">
        update mdm_audit_task
        <set>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="rejectReason != null">reject_reason = #{rejectReason},</if>
            <if test="auditBy != null and auditBy != ''">audit_by = #{auditBy},</if>
            audit_time = sysdate(),
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where task_id = #{taskId}
    </update>

</mapper>
