<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mdm.coderule.mapper.MdmCodeRuleMapper">

    <resultMap type="MdmCodeRule" id="MdmCodeRuleResult">
        <id     property="ruleId"      column="rule_id"      />
        <result property="objectId"    column="object_id"    />
        <result property="ruleName"    column="rule_name"    />
        <result property="resetType"   column="reset_type"   />
        <result property="status"      column="status"       />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
        <collection property="segments" ofType="MdmCodeRuleSegment" column="rule_id"
            select="com.ruoyi.mdm.coderule.mapper.MdmCodeRuleSegmentMapper.selectSegmentsByRuleId"/>
    </resultMap>

    <sql id="selectRuleVo">
        select rule_id, object_id, rule_name, reset_type, status, create_by, create_time, update_by, update_time, remark
        from mdm_code_rule
    </sql>

    <select id="selectRuleById" parameterType="Long" resultMap="MdmCodeRuleResult">
        <include refid="selectRuleVo"/>
        where rule_id = #{ruleId}
    </select>

    <select id="selectRuleList" parameterType="MdmCodeRule" resultMap="MdmCodeRuleResult">
        <include refid="selectRuleVo"/>
        <where>
            <if test="objectId != null">and object_id = #{objectId}</if>
            <if test="ruleName != null and ruleName != ''">and rule_name like concat('%', #{ruleName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by rule_id
    </select>

    <select id="selectRuleByObjectId" parameterType="Long" resultMap="MdmCodeRuleResult">
        <include refid="selectRuleVo"/>
        where object_id = #{objectId} limit 1
    </select>

    <insert id="insertRule" parameterType="MdmCodeRule" useGeneratedKeys="true" keyProperty="ruleId">
        insert into mdm_code_rule (
            object_id, rule_name,
            <if test="resetType != null and resetType != ''">reset_type,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
            update_by, update_time
        )values(
            #{objectId}, #{ruleName},
            <if test="resetType != null and resetType != ''">#{resetType},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
            #{updateBy}, sysdate()
        )
    </insert>

    <update id="updateRule" parameterType="MdmCodeRule">
        update mdm_code_rule
        <set>
            <if test="ruleName != null and ruleName != ''">rule_name = #{ruleName},</if>
            <if test="resetType != null and resetType != ''">reset_type = #{resetType},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where rule_id = #{ruleId}
    </update>

    <delete id="deleteRuleById" parameterType="Long">
        delete from mdm_code_rule where rule_id = #{ruleId}
    </delete>

</mapper>
