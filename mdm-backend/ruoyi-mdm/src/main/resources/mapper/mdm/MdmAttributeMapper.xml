<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.mdm.model.mapper.MdmAttributeMapper">

    <resultMap type="MdmAttribute" id="MdmAttributeResult">
        <id     property="attrId"        column="attr_id"        />
        <result property="objectId"      column="object_id"      />
        <result property="attrCode"      column="attr_code"      />
        <result property="attrName"      column="attr_name"      />
        <result property="dataType"      column="data_type"      />
        <result property="requiredFlag"  column="required_flag"  />
        <result property="uniqueFlag"    column="unique_flag"    />
        <result property="primaryFlag"   column="primary_flag"   />
        <result property="sourceType"    column="source_type"    />
        <result property="dictType"      column="dict_type"      />
        <result property="minValue"      column="min_value"      />
        <result property="maxValue"      column="max_value"      />
        <result property="enumValues"    column="enum_values"    />
        <result property="defaultValue"  column="default_value"  />
        <result property="orderNum"      column="order_num"      />
        <result property="status"        column="status"         />
        <result property="createBy"      column="create_by"      />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"      column="update_by"      />
        <result property="updateTime"    column="update_time"    />
        <result property="remark"        column="remark"         />
    </resultMap>

    <sql id="selectAttributeVo">
        select attr_id, object_id, attr_code, attr_name, data_type, required_flag, unique_flag,
               primary_flag, source_type, dict_type, min_value, max_value, enum_values, default_value,
               order_num, status, create_by, create_time, update_by, update_time, remark
        from mdm_attribute
    </sql>

    <select id="selectAttributeById" parameterType="Long" resultMap="MdmAttributeResult">
        <include refid="selectAttributeVo"/>
        where attr_id = #{attrId}
    </select>

    <select id="selectAttributeList" parameterType="MdmAttribute" resultMap="MdmAttributeResult">
        <include refid="selectAttributeVo"/>
        <where>
            <if test="objectId != null">and object_id = #{objectId}</if>
            <if test="attrCode != null and attrCode != ''">and attr_code like concat('%', #{attrCode}, '%')</if>
            <if test="attrName != null and attrName != ''">and attr_name like concat('%', #{attrName}, '%')</if>
            <if test="status != null and status != ''">and status = #{status}</if>
        </where>
        order by order_num
    </select>

    <select id="checkAttributeCodeUnique" resultMap="MdmAttributeResult">
        <include refid="selectAttributeVo"/>
        where object_id = #{objectId} and attr_code = #{attrCode} limit 1
    </select>

    <insert id="insertAttribute" parameterType="MdmAttribute" useGeneratedKeys="true" keyProperty="attrId">
        insert into mdm_attribute (
            object_id, attr_code, attr_name,
            <if test="dataType != null and dataType != ''">data_type,</if>
            <if test="requiredFlag != null and requiredFlag != ''">required_flag,</if>
            <if test="uniqueFlag != null and uniqueFlag != ''">unique_flag,</if>
            <if test="primaryFlag != null and primaryFlag != ''">primary_flag,</if>
            <if test="sourceType != null and sourceType != ''">source_type,</if>
            <if test="dictType != null and dictType != ''">dict_type,</if>
            <if test="minValue != null">min_value,</if>
            <if test="maxValue != null">max_value,</if>
            <if test="enumValues != null">enum_values,</if>
            <if test="defaultValue != null">default_value,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
            update_by, update_time
        )values(
            #{objectId}, #{attrCode}, #{attrName},
            <if test="dataType != null and dataType != ''">#{dataType},</if>
            <if test="requiredFlag != null and requiredFlag != ''">#{requiredFlag},</if>
            <if test="uniqueFlag != null and uniqueFlag != ''">#{uniqueFlag},</if>
            <if test="primaryFlag != null and primaryFlag != ''">#{primaryFlag},</if>
            <if test="sourceType != null and sourceType != ''">#{sourceType},</if>
            <if test="dictType != null and dictType != ''">#{dictType},</if>
            <if test="minValue != null">#{minValue},</if>
            <if test="maxValue != null">#{maxValue},</if>
            <if test="enumValues != null">#{enumValues},</if>
            <if test="defaultValue != null">#{defaultValue},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
            #{updateBy}, sysdate()
        )
    </insert>

    <update id="updateAttribute" parameterType="MdmAttribute">
        update mdm_attribute
        <set>
            <if test="attrName != null and attrName != ''">attr_name = #{attrName},</if>
            <if test="dataType != null and dataType != ''">data_type = #{dataType},</if>
            <if test="requiredFlag != null and requiredFlag != ''">required_flag = #{requiredFlag},</if>
            <if test="uniqueFlag != null and uniqueFlag != ''">unique_flag = #{uniqueFlag},</if>
            <if test="primaryFlag != null and primaryFlag != ''">primary_flag = #{primaryFlag},</if>
            <if test="sourceType != null and sourceType != ''">source_type = #{sourceType},</if>
            <if test="dictType != null and dictType != ''">dict_type = #{dictType},</if>
            <if test="minValue != null">min_value = #{minValue},</if>
            <if test="maxValue != null">max_value = #{maxValue},</if>
            <if test="enumValues != null">enum_values = #{enumValues},</if>
            <if test="defaultValue != null">default_value = #{defaultValue},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where attr_id = #{attrId}
    </update>

    <delete id="deleteAttributeById" parameterType="Long">
        delete from mdm_attribute where attr_id = #{attrId}
    </delete>

    <delete id="deleteAttributeByObjectIds" parameterType="Long">
        delete from mdm_attribute where object_id in
        <foreach item="objectId" collection="array" open="(" separator="," close=")">
            #{objectId}
        </foreach>
    </delete>

</mapper>
